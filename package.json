{
  "name": "solar-system-sandbox",
  "version": "1.0.0",
  "description": "An offline solar system gravity sandbox for Windows and Android",
  "main": "desktop/main.cjs",
  "private": true,
  "license": "MIT",
  "author": "BT Studio",
  "scripts": {
    "start": "node scripts/serve.cjs",
    "test": "node --test tests/*.test.cjs",
    "desktop": "electron .",
    "build:windows": "electron-builder --win portable --x64",
    "build:android-assets": "node scripts/android-assets.cjs",
    "test:ui": "node tests/ui.cjs"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "playwright-core": "^1.64.1"
  },
  "build": {
    "appId": "dev.btstudio.solarsystem",
    "productName": "Solar System Sandbox",
    "asar": true,
    "files": [
      "desktop/**/*",
      "web/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Solar-System-Sandbox-${version}-Windows-x64.exe"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
